<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>Orbit</AssemblyName>
    <RootNamespace>Orbit.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Windows with no icon of their own take the exe's. Made by tools/icon/make-ico.ps1. -->
    <ApplicationIcon>Assets\Orbit.ico</ApplicationIcon>
    <!-- Program.Main, so Velopack's install and update hooks run before WPF starts. -->
    <StartupObject>Orbit.App.Program</StartupObject>
  </PropertyGroup>

  <!-- The typing engine, when tools/typing-engine/build.ps1 has built it: copied to engine\ beside Orbit.exe. -->
  <ItemGroup Condition="Exists('..\..\artifacts\typing-engine-stage\version.txt')">
    <Content Include="..\..\artifacts\typing-engine-stage\**\*" Link="engine\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The engine never ships without its notices. build.ps1 writes them before version.txt, so this only catches a stage put together by hand. -->
  <Target Name="CheckEngineNotices" BeforeTargets="Build"
          Condition="Exists('..\..\artifacts\typing-engine-stage\version.txt') And !Exists('..\..\artifacts\typing-engine-stage\NOTICES.txt')">
    <Error Text="artifacts\typing-engine-stage has no NOTICES.txt: run tools/typing-engine/build.ps1." />
  </Target>

  <!-- Where updates come from. CI sets it (build.yml); without it the build can't check. -->
  <ItemGroup Condition="'$(UpdateRepo)' != ''">
    <AssemblyMetadata Include="UpdateRepo" Value="$(UpdateRepo)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orbit.Core\Orbit.Core.csproj" />
    <ProjectReference Include="..\Orbit.Native\Orbit.Native.csproj" />
  </ItemGroup>

</Project>
