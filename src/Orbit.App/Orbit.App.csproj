<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>Orbit</AssemblyName>
    <RootNamespace>Orbit.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Program.Main, so Velopack's install and update hooks run before WPF starts. -->
    <StartupObject>Orbit.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orbit.Core\Orbit.Core.csproj" />
    <ProjectReference Include="..\Orbit.Native\Orbit.Native.csproj" />
  </ItemGroup>

</Project>
