<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>Orbit</AssemblyName>
    <RootNamespace>Orbit.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Program.Main, so Velopack's install and update hooks run before WPF starts. -->
    <StartupObject>Orbit.App.Program</StartupObject>
  </PropertyGroup>

  <!-- The typing engine, when tools/araso/build.ps1 has built it: copied beside Orbit.exe. -->
  <ItemGroup Condition="Exists('..\..\artifacts\araso-stage\version.txt')">
    <Content Include="..\..\artifacts\araso-stage\**\*" Link="araso\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Where updates come from. CI sets it (build.yml); without it the build can't check. -->
  <ItemGroup Condition="'$(UpdateRepo)' != ''">
    <AssemblyMetadata Include="UpdateRepo" Value="$(UpdateRepo)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orbit.Core\Orbit.Core.csproj" />
    <ProjectReference Include="..\Orbit.Native\Orbit.Native.csproj" />
  </ItemGroup>

</Project>
